# Copy these names into Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Supabase (Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud Translation API key
GOOGLE_TRANSLATE_API_KEY=

# Twilio (Console dashboard). Leave blank to run in demo mode (texts are simulated).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
# Optional: use a Messaging Service instead of a single number
TWILIO_MESSAGING_SERVICE_SID=

# Your public site address, e.g. https://relaytext.io (keeps Twilio webhook signatures verifying)
APP_URL=https://relaytext.io

# Optional: secret for signing login sessions (defaults to the Supabase service key)
SESSION_SECRET=
